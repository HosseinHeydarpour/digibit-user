# Normalize line endings: store LF in the repository, check out native on Windows.
# Keeps the deployed HTML/CSS/JS identical regardless of who edits it.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.woff  binary
*.woff2 binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
